# ==============================================================================
# VERA - Variáveis de Ambiente
# ==============================================================================

# API Config
PROJECT_NAME="VERA API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# JWT Authentication
JWT_SECRET_KEY="vera-jwt-secret-key-dev-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Remote Serving (Colab + Tunnel ngrok/cloudflared)
# RN-INF01: A URL do LLM nunca deve ser hardcoded
LLM_ENDPOINT_URL=https://seu-tunel-ngrok.ngrok-free.app
LLM_API_KEY=sua_chave_de_autenticacao_do_tunel
LLM_MAX_TOKENS=1024

# Vector Store (Pinecone)
PINECONE_API_KEY=seu_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=vera-math-index
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large

# Cloudflare R2
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=seu_r2_access_key_id
R2_SECRET_ACCESS_KEY=seu_r2_secret_access_key
R2_BUCKET_NAME=vera

# Chunking Parameters (RN-CHUNK02)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vera_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vera_db
